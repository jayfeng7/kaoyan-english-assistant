# ---- LLM providers ----
# Server-side only. Never expose these values to the browser or commit .env.local.
# The application has no user authentication. Protect public deployments with
# Cloudflare Access, a reverse-proxy login, or a private network.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-chat

# 单次生成的最大输出 token 数（结构化结果较长，默认 8000 避免 JSON 被截断；需供应商支持）
LLM_MAX_TOKENS=8000

# ---- Baidu OCR (optional; image and scanned-PDF OCR) ----
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=

# ---- Rate limits ----
RATE_LIMIT_LLM_MAX=10
RATE_LIMIT_LLM_WINDOW_MS=60000
RATE_LIMIT_OCR_MAX=30
RATE_LIMIT_OCR_WINDOW_MS=60000
# 滚动 24 小时全站总预算（所有调用方合计；0 = 不限）。防止地址泄露后被轮换 IP 耗尽额度。
RATE_LIMIT_LLM_DAILY_MAX=500
RATE_LIMIT_OCR_DAILY_MAX=1200

# ---- 作文追问 RAG（1 = 启用，0 = 回到普通追问） ----
ESSAY_RAG_ENABLED=1
ESSAY_RAG_MODE=keyword
ESSAY_RAG_REWRITE=1
# 向量及混合检索需要先执行 pnpm rag:index。
# RAG_OLLAMA_URL=http://127.0.0.1:11434
# RAG_INDEX_PATH=artifacts/rag-index.json
# ESSAY_RAG_VECTOR_BACKEND=json
# RAG_QDRANT_URL=http://127.0.0.1:6333
# RAG_QDRANT_API_KEY=
# RAG_QDRANT_HNSW_EF=64
# ESSAY_RAG_MIN_COSINE=0.4
# ESSAY_RAG_TRACE=1
